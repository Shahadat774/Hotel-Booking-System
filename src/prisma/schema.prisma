datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model booking {
  id    Int     @id @default(autoincrement())
  userid  Int
  hotelid Int
  createdat DateTime @default(now())
  updatedat DateTime @updatedAt
  bookingAmount Int
  status bookingstatus
  uuid String? @unique
}
enum bookingstatus{
  pending
  confirmed
  cancelled
}